<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Somente o servidor compila e acessa a camada de banco. -->
    <Compile Remove="Data/**/*.cs;Migrations/**/*.cs;Models/**/*.cs;Repositorio/**/*.cs;Sockets/**/*.cs" />
    <None Update="servidor.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
